# PolisayAI Environment Variables Example

# Gemini AI API Key (Required for analysis and social screening)
# Get your key at: https://aistudio.google.com/
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key_here

# Exa Neural Search API Key (Required for Social/Community Scraper)
# This provides search-index based access to X, YouTube, and Communities without official APIs.
# Get your key at: https://exa.ai/
EXA_API_KEY=your_exa_api_key_here


